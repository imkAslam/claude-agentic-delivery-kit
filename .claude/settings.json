{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "env": {
    "DELIVERY_MAX_ROUNDS": "3",
    "DELIVERY_PROFILE": "standard",
    "DELIVERY_MAX_PARALLEL": "3",
    "DELIVERY_TOKEN_BUDGET": "0",
    "DELIVERY_FRESH_CONTEXT": "100000"
  },
  "permissions": {
    "allow": [
      "Edit(./**)", "Write(./**)", "WebSearch", "WebFetch",
      "Bash(bash .claude/*)", "Bash(.claude/*)",
      "Bash(git init:*)", "Bash(git status:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git switch:*)",
      "Bash(git checkout:*)", "Bash(git branch:*)", "Bash(git worktree:*)", "Bash(git merge:*)", "Bash(git merge-base:*)",
      "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git push:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)",
      "Bash(git rev-parse:*)", "Bash(git rev-list:*)", "Bash(git ls-files:*)", "Bash(git tag:*)", "Bash(git mv:*)",
      "Bash(git remote -v:*)", "Bash(git config --get:*)", "Bash(git restore --staged:*)",
      "Bash(gh auth status:*)", "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh pr checks:*)",
      "Bash(gh run list:*)", "Bash(gh run view:*)", "Bash(gh issue:*)",
      "Bash(glab auth status:*)", "Bash(glab mr create:*)", "Bash(glab mr view:*)", "Bash(glab ci status:*)", "Bash(glab issue:*)",
      "Bash(pnpm:*)", "Bash(npm run:*)", "Bash(npm test:*)", "Bash(npm ci:*)", "Bash(npm install:*)", "Bash(npx:*)",
      "Bash(yarn:*)", "Bash(bun:*)", "Bash(node:*)", "Bash(uv run:*)", "Bash(uv sync:*)", "Bash(pytest:*)",
      "Bash(go test:*)", "Bash(go build:*)", "Bash(make:*)",
      "Bash(docker info:*)", "Bash(docker ps:*)", "Bash(docker compose ps:*)", "Bash(docker compose logs:*)",
      "Bash(cd:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(grep:*)", "Bash(rg:*)",
      "Bash(sed -n:*)", "Bash(awk:*)", "Bash(sort:*)", "Bash(diff:*)", "Bash(jq:*)", "Bash(mkdir:*)", "Bash(touch:*)",
      "Bash(cp:*)", "Bash(mv:*)", "Bash(echo:*)", "Bash(printf:*)", "Bash(test:*)", "Bash(which:*)", "Bash(date:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)", "Bash(git clean -f:*)",
      "Bash(sudo:*)", "Read(./.env)", "Read(./.env.local)", "Read(./.env.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-gates.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-coding.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-boundary.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-prod.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-coding.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-services.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-gate.sh", "timeout": 900 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-coding.sh" }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-budget.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-usage.sh", "timeout": 60 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-usage.sh", "timeout": 60 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-usage.sh", "timeout": 60 } ] }
    ]
  }
}
